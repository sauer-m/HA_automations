      {
       "type": "markdown",
       "text_only": true,
       "content": "{% set h = now().hour %}{% set tage = ['Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag','Sonntag'] %}{% set monate = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'] %}{% set wx = {'clear-night':'klar','cloudy':'bewölkt','exceptional':'Unwetter','fog':'Nebel','hail':'Hagel','lightning':'Gewitter','lightning-rainy':'Gewitter','partlycloudy':'teils bewölkt','pouring':'Starkregen','rainy':'Regen','snowy':'Schnee','snowy-rainy':'Schneeregen','sunny':'sonnig','windy':'windig','windy-variant':'windig'} %}{% set w = 'weather.weather_23554_lubeck_deutschland' %}{% set p = ['person.sauerm','person.sarah'] %}{% set zuhause = p | select('is_state','home') | list %}{% set weg = p | reject('is_state','home') | list %}{% set n = states('sensor.hinweise_anzahl') | int(0) %}{% macro wer(e) %}{{ 'du' if state_attr(e,'friendly_name') == user.split(' ')[0] else '**' ~ state_attr(e,'friendly_name') ~ '**' }}{% endmacro %}{% macro wo(e) %}{{ 'unterwegs' if is_state(e,'not_home') else ('auf der Arbeit' if is_state(e,'Arbeit') else 'bei ' ~ states(e)) }}{% endmacro %}<small>{{ tage[now().weekday()] }}, {{ now().day }}. {{ monate[now().month-1] }}</small>\n\n## {% if h < 5 or h >= 23 %}Gute Nacht{% elif h < 11 %}Guten Morgen{% elif h < 18 %}Hallo{% else %}Guten Abend{% endif %} {{ user.split(' ')[0] }}\n\n{% if zuhause | count == 2 %}Ihr seid beide zu Hause{% elif zuhause | count == 1 %}{% set a = wer(zuhause[0]) %}{{ 'Du bist' if a == 'du' else a ~ ' ist' }} zu Hause{% for e in weg %}, {% set b = wer(e) %}{{ b }} {{ 'bist' if b == 'du' else 'ist' }} {{ wo(e) }}{% endfor %}{% else %}Niemand ist zu Hause{% endif %}, {{ 'alles ist abgeschlossen' if is_state('lock.wohnungstur','locked') else '**die Wohnungstür ist offen**' }}. {% if n == 0 %}Nichts zu tun.{% elif n == 1 %}**1 Hinweis.**{% else %}**{{ n }} Hinweise.**{% endif %}\n\n<small>Lübeck {{ state_attr(w,'temperature') | round(1) | string | replace('.',',') }} °C · {{ wx.get(states(w), states(w)) }} · Wind {{ state_attr(w,'wind_speed') | round(0) | int }} km/h · {% if is_state('sun.sun','above_horizon') %}Sonnenuntergang {{ as_timestamp(state_attr('sun.sun','next_setting')) | timestamp_custom('%H:%M') }}{% else %}Sonnenaufgang {{ as_timestamp(state_attr('sun.sun','next_rising')) | timestamp_custom('%H:%M') }}{% endif %}</small>",
       "grid_options": {
        "columns": "full"
       }
