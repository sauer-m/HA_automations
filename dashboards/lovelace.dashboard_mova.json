                  "secondary": "{% if is_state('vacuum.p50_pro_ultra','cleaning') or is_state('vacuum.p50_pro_ultra','paused') %}Raum: {{ states('sensor.p50_pro_ultra_current_room') }} · {{ states('sensor.p50_pro_ultra_cleaned_area') }} m² · {{ states('sensor.p50_pro_ultra_cleaning_time') }} min{% else %}Station: {{ state_translated('sensor.p50_pro_ultra_state') }}{% endif %}{% if not is_state('sensor.p50_pro_ultra_error','no_error') %} · ⚠ {{ state_translated('sensor.p50_pro_ultra_error') }}{% endif %}",
                  "icon": "{% set s = states('vacuum.p50_pro_ultra') %}{{ {'cleaning':'mdi:robot-vacuum','returning':'mdi:home-import-outline','paused':'mdi:pause-circle','error':'mdi:robot-vacuum-alert','docked':'mdi:home-battery'}.get(s,'mdi:robot-vacuum-variant') }}",
